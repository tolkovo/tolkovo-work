---
// Waitlist form (docs/05-landing.md §3.11, backlog L-01). Double opt-in happens on the server:
// the form only collects the address and explicit consent (GDPR art. 7, 152-ФЗ ст. 9).
import { getDict, type Locale } from "../i18n";
import { COMMUNITY_CHAT_URL, WAITLIST_ENDPOINT } from "../site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const w = getDict(locale).waitlist;
const messages = {
  sending: w.sending,
  submit: w.submit,
  successText: w.successText,
  errEmailEmpty: w.errEmailEmpty,
  errEmailFormat: w.errEmailFormat,
  errConsent: w.errConsent,
  errUnavailable: w.errUnavailable,
  errRateLimited: w.errRateLimited,
  errInvalid: w.errInvalid,
  errFallbackLink: w.errFallbackLink,
  fallbackUrl: COMMUNITY_CHAT_URL,
};
---

<section class="s" id="waitlist" aria-labelledby="waitlist-title">
  <div class="wrap">
    <div class="final">
      <div>
        <h2 id="waitlist-title">{w.title}</h2>
        <p class="sub">{w.text}</p>
      </div>
      <div>
        <form
          id="wl"
          method="post"
          action={WAITLIST_ENDPOINT}
          novalidate
          data-locale={locale}
          data-messages={JSON.stringify(messages)}
        >
          <div class="field">
            <label for="wl-email">{w.emailLabel}</label>
            <input
              type="email"
              id="wl-email"
              name="email"
              autocomplete="email"
              inputmode="email"
              spellcheck="false"
              maxlength="254"
              required
              placeholder={w.emailPlaceholder}
              aria-describedby="wl-email-err"
            />
            <p class="err" id="wl-email-err"></p>
          </div>
          <fieldset>
            <legend>{w.channelsLegend}</legend>
            {
              w.channels.map((c) => (
                <label class="check">
                  <input type="checkbox" name="channels" value={c.value} checked={c.checked} />
                  {c.label}
                </label>
              ))
            }
          </fieldset>
          <div class="hp" aria-hidden="true">
            <label for="wl-website">{w.honeypotLabel}</label>
            <input type="text" id="wl-website" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <div class="field">
            <label class="consent">
              <input
                type="checkbox"
                id="wl-consent"
                name="consent"
                value="true"
                required
                aria-describedby="wl-consent-err wl-note"
              />
              <span>{w.consent}</span>
            </label>
            <p class="err" id="wl-consent-err"></p>
          </div>
          <p class="note" id="wl-note">{w.privacyNote}</p>
          <input type="hidden" name="locale" value={locale} />
          <button class="btn btn-primary" type="submit">{w.submit}</button>
          <div class="status" id="wl-status" role="status" aria-live="polite"></div>
        </form>
        <div class="done" id="wl-done" tabindex="-1" hidden>
          <h3>{w.successTitle}</h3>
          <p id="wl-done-text"></p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import "../scripts/waitlist.ts";
</script>
