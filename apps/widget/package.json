{
  "name": "@tolkovo/widget",
  "version": "0.1.0",
  "private": true,
  "description": "Tolkovo chat widget for sites and Electron apps: a live chat with your support team, styled in code.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && vite build --mode script && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run",
    "size": "size-limit"
  },
  "devDependencies": {
    "@size-limit/file": "14.1.0",
    "@tolkovo/api-client": "workspace:*",
    "@tolkovo/config": "workspace:*",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "preact": "11.0.0",
    "size-limit": "14.1.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
