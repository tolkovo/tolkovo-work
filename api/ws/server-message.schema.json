{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tolkovo.dev/schemas/ws/server-message.schema.json",
  "title": "Tolkovo realtime: server → client message",
  "description": "One JSON text frame from the realtime gateway (GET /api/v1/realtime, docs/02 §10, ADR-0005). Every message is {type, id, ts, data}. Domain events also carry seq, the publication order a client resumes from after a reconnect; seq may have gaps and events may arrive more than once, so clients deduplicate by id. Signals (conversation.typing, conversation.viewers) are ephemeral: no seq, never replayed, not deduplicated. A new field in data is not a breaking change; removing or renaming one is (docs/00 §8).",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/heartbeat" },
    { "$ref": "#/$defs/resumed" },
    { "$ref": "#/$defs/resyncRequired" },
    { "$ref": "#/$defs/conversationTyping" },
    { "$ref": "#/$defs/conversationViewers" },
    { "$ref": "#/$defs/conversationCreated" },
    { "$ref": "#/$defs/conversationStatusChanged" },
    { "$ref": "#/$defs/conversationAssigned" },
    { "$ref": "#/$defs/conversationTagsChanged" },
    { "$ref": "#/$defs/conversationIssuesChanged" },
    { "$ref": "#/$defs/conversationRead" },
    { "$ref": "#/$defs/messageCreated" },
    { "$ref": "#/$defs/messageDelivery" },
    { "$ref": "#/$defs/contactCreated" },
    { "$ref": "#/$defs/contactUpdated" }
  ],
  "$defs": {
    "messageType": {
      "description": "Every server message type. Control messages have no dot; domain events are outbox topics; conversation.typing and conversation.viewers are signals.",
      "enum": [
        "hello",
        "heartbeat",
        "resumed",
        "resync_required",
        "conversation.typing",
        "conversation.viewers",
        "conversation.created",
        "conversation.status_changed",
        "conversation.assigned",
        "conversation.tags_changed",
        "conversation.issues_changed",
        "conversation.read",
        "message.created",
        "message.delivery",
        "contact.created",
        "contact.updated"
      ]
    },
    "closeCode": {
      "description": "WebSocket close codes the gateway uses. 1008: protocol violation (unknown or repeated client message), do not retry without a fix. 1009: client message above the size limit. 1011: internal error, reconnect with backoff. 1012: server restart or shutdown, reconnect with jitter. 4401: the session ended (signed out, revoked, expired, membership removed), do not reconnect, re-check the session over REST. 4408: slow consumer, the send buffer overflowed, reconnect and resume. 4429: too many connections of this user, reconnect only after a long backoff.",
      "enum": [1008, 1009, 1011, 1012, 4401, 4408, 4429]
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "nullableUuid": {
      "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
    },
    "seq": {
      "description": "Publication order of outbox events. Monotonic per installation, gaps allowed.",
      "type": "integer",
      "minimum": 0
    },
    "ts": {
      "description": "RFC 3339 time: when the event happened, or when a control message was sent.",
      "type": "string",
      "format": "date-time"
    },
    "id": {
      "description": "Unique message id. For domain events it is the outbox event id, the same on every redelivery: the deduplication key.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "conversationStatus": {
      "enum": ["new", "bot", "queued", "assigned", "pending", "resolved", "closed"]
    },
    "control": {
      "type": "object",
      "required": ["type", "id", "ts", "data"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ts": { "$ref": "#/$defs/ts" }
      }
    },
    "event": {
      "type": "object",
      "required": ["type", "id", "ts", "seq", "data"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ts": { "$ref": "#/$defs/ts" },
        "seq": { "$ref": "#/$defs/seq" }
      }
    },
    "hello": {
      "description": "First message after the handshake. A client without history starts from data.seq and refetches over REST; a client with history answers with resume.",
      "allOf": [{ "$ref": "#/$defs/control" }],
      "properties": {
        "type": { "const": "hello" },
        "data": {
          "type": "object",
          "required": ["seq", "heartbeat_interval_ms"],
          "properties": {
            "seq": { "$ref": "#/$defs/seq" },
            "heartbeat_interval_ms": {
              "description": "The server sends heartbeat this often; a client that hears nothing for twice as long reconnects.",
              "type": "integer",
              "minimum": 1000
            }
          }
        }
      }
    },
    "heartbeat": {
      "description": "Sent every heartbeat_interval_ms so clients notice a dead connection.",
      "allOf": [{ "$ref": "#/$defs/control" }],
      "properties": {
        "type": { "const": "heartbeat" },
        "data": { "type": "object" }
      }
    },
    "resumed": {
      "description": "Catch-up after resume is complete: every missed event up to data.seq has been sent.",
      "allOf": [{ "$ref": "#/$defs/control" }],
      "properties": {
        "type": { "const": "resumed" },
        "data": {
          "type": "object",
          "required": ["seq"],
          "properties": { "seq": { "$ref": "#/$defs/seq" } }
        }
      }
    },
    "resyncRequired": {
      "description": "Missed events cannot be replayed (pruned by retention or too many): refetch everything over REST and continue from data.seq.",
      "allOf": [{ "$ref": "#/$defs/control" }],
      "properties": {
        "type": { "const": "resync_required" },
        "data": {
          "type": "object",
          "required": ["seq"],
          "properties": { "seq": { "$ref": "#/$defs/seq" } }
        }
      }
    },
    "conversationTyping": {
      "description": "Signal: someone is typing in a conversation or stopped. Show it for at most 6 s after the last start; a stop or a new message from the same actor ends it earlier.",
      "allOf": [{ "$ref": "#/$defs/control" }],
      "properties": {
        "type": { "const": "conversation.typing" },
        "data": {
          "type": "object",
          "required": ["conversation_id", "actor", "actor_id", "state"],
          "properties": {
            "conversation_id": { "$ref": "#/$defs/uuid" },
            "actor": { "enum": ["operator", "contact", "bot"] },
            "actor_id": { "$ref": "#/$defs/nullableUuid" },
            "state": { "enum": ["start", "stop"] }
          }
        }
      }
    },
    "conversationViewers": {
      "description": "Signal: every member who has the conversation open, sent when the list changes and when a viewer refreshes. It replaces the previous list; a list not refreshed for 60 s is stale. The receiver's own id may be in it.",
      "allOf": [{ "$ref": "#/$defs/control" }],
      "properties": {
        "type": { "const": "conversation.viewers" },
        "data": {
          "type": "object",
          "required": ["conversation_id", "user_ids"],
          "properties": {
            "conversation_id": { "$ref": "#/$defs/uuid" },
            "user_ids": { "type": "array", "items": { "$ref": "#/$defs/uuid" }, "uniqueItems": true }
          }
        }
      }
    },
    "conversationCreated": {
      "allOf": [{ "$ref": "#/$defs/event" }],
      "properties": {
        "type": { "const": "conversation.created" },
        "data": {
          "type": "object",
          "required": ["conversation_id", "contact_id", "number", "status"],
          "properties": {
            "conversation_id": { "$ref": "#/$defs/uuid" },
            "contact_id": { "$ref": "#/$defs/uuid" },
            "number": { "type": "integer", "minimum": 1 },
            "status": { "$ref": "#/$defs/conversationStatus" }
          }
        }
      }
    },
    "conversationStatusChanged": {
      "allOf": [{ "$ref": "#/$defs/event" }],
      "properties": {
        "type": { "const": "conversation.status_changed" },
        "data": {
          "type": "object",
          "required": ["conversation_id", "from", "to", "assignee_id", "actor_id"],
          "properties": {
            "conversation_id": { "$ref": "#/$defs/uuid" },
            "from": { "$ref": "#/$defs/conversationStatus" },
            "to": { "$ref": "#/$defs/conversationStatus" },
            "assignee_id": { "$ref": "#/$defs/nullableUuid" },
            "actor_id": { "$ref": "#/$defs/nullableUuid", "description": "Who made the change; null for the system." }
          }
        }
      }
    },
    "conversationAssigned": {
      "allOf": [{ "$ref": "#/$defs/event" }],
      "properties": {
        "type": { "const": "conversation.assigned" },
        "data": {
          "type": "object",
          "required": ["conversation_id", "assignee_id", "previous_assignee_id", "actor_id"],
          "properties": {
            "conversation_id": { "$ref": "#/$defs/uuid" },
            "assignee_id": { "$ref": "#/$defs/nullableUuid" },
            "previous_assignee_id": { "$ref": "#/$defs/nullableUuid" },
            "actor_id": {
              "$ref": "#/$defs/nullableUuid",
              "description": "Who made the change; null for the system. Equal to assignee_id when a member took the conversation: the panel alerts only about conversations given to the member by someone else."
            }
          }
        }
      }
    },
    "conversationTagsChanged": {
      "description": "The tags of a conversation changed; clients fetch it over REST.",
      "allOf": [{ "$ref": "#/$defs/event" }],
      "properties": {
        "type": { "const": "conversation.tags_changed" },
        "data": {
          "type": "object",
          "required": ["conversation_id"],
          "properties": {
            "conversation_id": { "$ref": "#/$defs/uuid" }
          }
        }
      }
    },
    "conversationIssuesChanged": {
      "description": "A GitHub issue of a conversation was created, linked, failed or removed (ADR-0012); clients fetch the issues and the conversation over REST.",
      "allOf": [{ "$ref": "#/$defs/event" }],
      "properties": {
        "type": { "const": "conversation.issues_changed" },
        "data": {
          "type": "object",
          "required": ["conversation_id"],
          "properties": {
            "conversation_id": { "$ref": "#/$defs/uuid" }
          }
        }
      }
    },
    "conversationRead": {
      "description": "A read mark moved forward. Read marks are per member: only the reader's own clients act on it (their unread counters), others ignore it.",
      "allOf": [{ "$ref": "#/$defs/event" }],
      "properties": {
        "type": { "const": "conversation.read" },
        "data": {
          "type": "object",
          "required": ["conversation_id", "reader_type", "reader_id", "up_to_message_id"],
          "properties": {
            "conversation_id": { "$ref": "#/$defs/uuid" },
            "reader_type": { "enum": ["operator"] },
            "reader_id": { "$ref": "#/$defs/uuid" },
            "up_to_message_id": { "$ref": "#/$defs/uuid" }
          }
        }
      }
    },
    "messageCreated": {
      "description": "Ids and kind only: the text is fetched over REST, so message bodies never pass through Redis.",
      "allOf": [{ "$ref": "#/$defs/event" }],
      "properties": {
        "type": { "const": "message.created" },
        "data": {
          "type": "object",
          "required": ["conversation_id", "message_id", "kind", "is_private", "sender_type", "sender_id"],
          "properties": {
            "conversation_id": { "$ref": "#/$defs/uuid" },
            "message_id": { "$ref": "#/$defs/uuid" },
            "kind": { "enum": ["text", "media", "note", "event"] },
            "is_private": { "type": "boolean" },
            "sender_type": { "enum": ["contact", "operator", "bot", "system"] },
            "sender_id": { "$ref": "#/$defs/nullableUuid" }
          }
        }
      }
    },
    "messageDelivery": {
      "description": "The delivery of an operator reply through its channel moved on: pending (queued again after a retry), sent, read (the customer opened the chat; personal Telegram accounts only) or failed with a reason. Refetch the message or patch its delivery_status and delivery_error.",
      "allOf": [{ "$ref": "#/$defs/event" }],
      "properties": {
        "type": { "const": "message.delivery" },
        "data": {
          "type": "object",
          "required": ["conversation_id", "message_id", "status", "error"],
          "properties": {
            "conversation_id": { "$ref": "#/$defs/uuid" },
            "message_id": { "$ref": "#/$defs/uuid" },
            "status": { "enum": ["pending", "sent", "delivered", "read", "failed"] },
            "error": {
              "anyOf": [
                { "enum": ["blocked", "chat_not_found", "limited", "rejected", "channel_unavailable", "failed"] },
                { "type": "null" }
              ]
            }
          }
        }
      }
    },
    "contactCreated": {
      "allOf": [{ "$ref": "#/$defs/event" }],
      "properties": {
        "type": { "const": "contact.created" },
        "data": {
          "type": "object",
          "required": ["contact_id"],
          "properties": { "contact_id": { "$ref": "#/$defs/uuid" } }
        }
      }
    },
    "contactUpdated": {
      "allOf": [{ "$ref": "#/$defs/event" }],
      "properties": {
        "type": { "const": "contact.updated" },
        "data": {
          "type": "object",
          "required": ["contact_id"],
          "properties": { "contact_id": { "$ref": "#/$defs/uuid" } }
        }
      }
    }
  }
}
