# Every TOLKOVO_* variable the server reads, with safe self-host defaults.
# Copy to .env and change the passwords before exposing anything.

# --- Server ---------------------------------------------------------------
# development | production
TOLKOVO_ENV=development
TOLKOVO_HTTP_ADDR=:8080
# debug | info | warn | error
TOLKOVO_LOG_LEVEL=info
# json | text
TOLKOVO_LOG_FORMAT=json
TOLKOVO_SHUTDOWN_TIMEOUT=20s
# Application role: member of tolkovo_app, not the table owner, no BYPASSRLS.
TOLKOVO_DATABASE_URL=postgres://tolkovo_app_dev:tolkovo_app_dev@localhost:5432/tolkovo?sslmode=disable
# Table owner, used only by `tolkovo migrate`.
TOLKOVO_MIGRATE_DATABASE_URL=postgres://tolkovo:tolkovo@localhost:5432/tolkovo?sslmode=disable
# System role for the worker (outbox relay, retention): member of
# tolkovo_system. Required for --role=worker and --role=all.
TOLKOVO_SYSTEM_DATABASE_URL=postgres://tolkovo_system_dev:tolkovo_system_dev@localhost:5432/tolkovo?sslmode=disable
# How long published events are kept for realtime catch-up (minimum 1m).
TOLKOVO_OUTBOX_RETENTION=24h
# selfhost | saas. saas refuses single-node settings (the fs storage driver).
TOLKOVO_MODE=selfhost
# Public base URL of the api as clients see it (scheme and host, no query).
# Signed upload and download links of the fs storage driver point here.
TOLKOVO_PUBLIC_URL=http://localhost:8080

# --- File storage (docs/adr/0009-file-storage.md) ---------------------------
# fs: local disk, one node only (self-host default). s3: any S3-compatible
# service (required with TOLKOVO_MODE=saas or several api replicas).
TOLKOVO_STORAGE_DRIVER=fs
# Lifetime of signed upload/download links (1m to 24h).
TOLKOVO_STORAGE_URL_TTL=15m
# fs: directory for files; mount a volume here in Docker.
TOLKOVO_STORAGE_FS_ROOT=./data/files
# fs: HMAC key for links, at least 32 characters (`openssl rand -hex 32`).
# Required in production. Empty in development means a random key per start.
TOLKOVO_STORAGE_SIGNING_KEY=
# s3: endpoint of the service; empty means AWS. The dev Garage from
# docker-compose.dev.yml is below; it needs path-style and region "garage".
# Set TOLKOVO_STORAGE_DRIVER=s3 to use it.
TOLKOVO_STORAGE_S3_ENDPOINT=http://localhost:3900
TOLKOVO_STORAGE_S3_REGION=garage
TOLKOVO_STORAGE_S3_BUCKET=tolkovo
TOLKOVO_STORAGE_S3_ACCESS_KEY_ID=GKdeadbeefdeadbeefdeadbeef
TOLKOVO_STORAGE_S3_SECRET_ACCESS_KEY=cafebabecafebabecafebabecafebabecafebabecafebabecafebabecafebabe
# true for Garage, SeaweedFS and most self-hosted services.
TOLKOVO_STORAGE_S3_PATH_STYLE=true
# Redis (or Valkey) for sessions and rate limits: redis:// or rediss:// (TLS).
TOLKOVO_REDIS_URL=redis://localhost:6379/0
# A session ends after this long without requests, and at the latest this
# long after sign-in. Outside development the session cookie is Secure, so
# the panel must be served over HTTPS.
TOLKOVO_SESSION_IDLE_TIMEOUT=168h
TOLKOVO_SESSION_MAX_AGE=720h
# Comma-separated origins besides TOLKOVO_PUBLIC_URL and the request's own
# host that may send unsafe requests (POST, PATCH, ...), e.g.
# https://panel.example.com. Empty: none.
TOLKOVO_TRUSTED_ORIGINS=
# Reverse proxies in front of the api (IPs or CIDRs, comma-separated), e.g.
# the compose network of Caddy: 172.16.0.0/12. Their X-Forwarded-For names
# the client for rate limits. Empty: the TCP peer is the client, so behind a
# proxy all visitors share its limits. Never 0.0.0.0/0.
TOLKOVO_TRUSTED_PROXIES=

# --- Outgoing email (SMTP) -------------------------------------------------
# Empty host: no email. The values below point at Mailpit from
# docker-compose.dev.yml (web UI on http://localhost:8025).
TOLKOVO_SMTP_HOST=localhost
# 0 means the usual port of the TLS mode: 587 starttls, 465 tls, 25 none.
TOLKOVO_SMTP_PORT=1025
# starttls (mandatory upgrade, no clear-text fallback) | tls (implicit TLS)
# | none (clear text; in production only for a relay on localhost).
TOLKOVO_SMTP_TLS=none
TOLKOVO_SMTP_USER=
TOLKOVO_SMTP_PASSWORD=
# Sender of invitations and password resets: noreply@ on your own domain
# (set SPF, DKIM and DMARC for it at your mail provider).
TOLKOVO_SMTP_FROM=Tolkovo <noreply@tolkovo.localhost>
TOLKOVO_SMTP_TIMEOUT=15s

# --- Dependencies (docker-compose.dev.yml) --------------------------------
POSTGRES_USER=tolkovo
POSTGRES_PASSWORD=tolkovo
POSTGRES_DB=tolkovo
APP_DB_USER=tolkovo_app_dev
APP_DB_PASSWORD=tolkovo_app_dev
SYSTEM_DB_USER=tolkovo_system_dev
SYSTEM_DB_PASSWORD=tolkovo_system_dev
# Garage (S3 for development). Dev-only placeholder values: Garage wants
# 32 hex bytes for the RPC secret, GK + 24 hex for the key id, 64 hex for the
# secret key. Generate real ones with `openssl rand -hex 32` for anything else.
GARAGE_RPC_SECRET=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef
GARAGE_BUCKET=tolkovo
GARAGE_KEY_ID=GKdeadbeefdeadbeefdeadbeef
GARAGE_SECRET_KEY=cafebabecafebabecafebabecafebabecafebabecafebabecafebabecafebabe
