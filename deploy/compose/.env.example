# Every TOLKOVO_* variable the server reads, with safe self-host defaults.
# Copy to .env and change the passwords before exposing anything.

# --- Server ---------------------------------------------------------------
# development | production
TOLKOVO_ENV=development
TOLKOVO_HTTP_ADDR=:8080
# debug | info | warn | error
TOLKOVO_LOG_LEVEL=info
# json | text
TOLKOVO_LOG_FORMAT=json
TOLKOVO_SHUTDOWN_TIMEOUT=20s
# Application role: member of tolkovo_app, not the table owner, no BYPASSRLS.
TOLKOVO_DATABASE_URL=postgres://tolkovo_app_dev:tolkovo_app_dev@localhost:5432/tolkovo?sslmode=disable
# Table owner, used only by `tolkovo migrate`.
TOLKOVO_MIGRATE_DATABASE_URL=postgres://tolkovo:tolkovo@localhost:5432/tolkovo?sslmode=disable
# System role for the worker (outbox relay, retention): member of
# tolkovo_system. Required for --role=worker and --role=all.
TOLKOVO_SYSTEM_DATABASE_URL=postgres://tolkovo_system_dev:tolkovo_system_dev@localhost:5432/tolkovo?sslmode=disable
# How long published events are kept for realtime catch-up (minimum 1m).
TOLKOVO_OUTBOX_RETENTION=24h

# --- Dependencies (docker-compose.dev.yml) --------------------------------
POSTGRES_USER=tolkovo
POSTGRES_PASSWORD=tolkovo
POSTGRES_DB=tolkovo
APP_DB_USER=tolkovo_app_dev
APP_DB_PASSWORD=tolkovo_app_dev
SYSTEM_DB_USER=tolkovo_system_dev
SYSTEM_DB_PASSWORD=tolkovo_system_dev
MINIO_ROOT_USER=tolkovo
MINIO_ROOT_PASSWORD=tolkovo-dev-secret
