# Read by docker compose for ${...} in docker-compose.yml: the image and the
# database logins. Copy to .env and replace every password.
# Use hex passwords (`openssl rand -hex 24`): they go into URLs unescaped.

# The image to run, e.g. registry.example.com/tolkovo:0.1.0 (deploy/README.md §2).
TOLKOVO_IMAGE=tolkovo:latest

# Table owner: runs migrations only (the migrate service).
POSTGRES_USER=tolkovo
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=tolkovo
# Login names must differ from the group roles tolkovo_app and tolkovo_system
# that ../compose/initdb/01-app-role.sh creates and puts them in.
# Application role: RLS applies, owns nothing.
APP_DB_USER=tolkovo_app_login
APP_DB_PASSWORD=change-me-app
# System role: outbox relay and cleanup across workspaces, by explicit policies.
SYSTEM_DB_USER=tolkovo_system_login
SYSTEM_DB_PASSWORD=change-me-system
