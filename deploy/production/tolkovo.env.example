# Settings of the Tolkovo app for docker-compose.yml. Copy to tolkovo.env.
# The image already sets TOLKOVO_ENV=production, TOLKOVO_HTTP_ADDR=:8080,
# TOLKOVO_LOG_FORMAT=json, TOLKOVO_PANEL_DIR and TOLKOVO_STORAGE_FS_ROOT.
# Database and Redis URLs come from docker-compose.yml. The full list of
# settings with comments: ../compose/.env.example.

# --- Required ----------------------------------------------------------------
# The https address people open; the panel, the API, webhooks and widget
# requests all use it. Telegram webhooks need valid HTTPS here.
TOLKOVO_PUBLIC_URL=https://support.example.com
# Encrypts bot tokens, Telegram sessions, AI and GitHub secrets in the
# database. Generate: docker run --rm tolkovo:latest keygen
# Back it up apart from the database: without it those secrets are lost.
TOLKOVO_MASTER_KEY=
TOLKOVO_MASTER_KEY_VERSION=1
TOLKOVO_MASTER_KEYS_RETIRED=
# Signs links to files of the fs driver: `openssl rand -hex 32`.
TOLKOVO_STORAGE_SIGNING_KEY=

# --- Accounts ------------------------------------------------------------------
# first: the first person to sign up becomes the owner, everyone else joins
# by invitation (Settings → Team). closed: nobody signs up. open: anyone.
TOLKOVO_REGISTRATION=first

# --- Reverse proxy -----------------------------------------------------------
# Addresses of the proxy in front of the app (IPs or CIDRs). Its
# X-Forwarded-For then names the visitor for rate limits. A proxy on the host
# reaches the published port from the Docker bridge gateway, usually
# 172.17.0.1 or the compose network's .1 (`docker network inspect
# tolkovo_default`). Never 0.0.0.0/0.
TOLKOVO_TRUSTED_PROXIES=

# --- Logs and limits -----------------------------------------------------------
TOLKOVO_LOG_LEVEL=info
TOLKOVO_SHUTDOWN_TIMEOUT=20s
TOLKOVO_SESSION_IDLE_TIMEOUT=168h
TOLKOVO_SESSION_MAX_AGE=720h
TOLKOVO_OUTBOX_RETENTION=24h

# --- Files ---------------------------------------------------------------------
# fs: the `files` volume, one app container only. s3: any S3-compatible
# bucket in the EU, needed for several app containers.
TOLKOVO_STORAGE_DRIVER=fs
TOLKOVO_STORAGE_URL_TTL=15m
# TOLKOVO_STORAGE_S3_ENDPOINT=https://fsn1.your-objectstorage.com
# TOLKOVO_STORAGE_S3_REGION=fsn1
# TOLKOVO_STORAGE_S3_BUCKET=tolkovo
# TOLKOVO_STORAGE_S3_ACCESS_KEY_ID=
# TOLKOVO_STORAGE_S3_SECRET_ACCESS_KEY=
# TOLKOVO_STORAGE_S3_PATH_STYLE=false

# --- Email (recommended) -------------------------------------------------------
# Empty host: no email; invitation links are shown to the admin instead and
# password reset by email is off.
TOLKOVO_SMTP_HOST=
TOLKOVO_SMTP_PORT=587
TOLKOVO_SMTP_TLS=starttls
TOLKOVO_SMTP_USER=
TOLKOVO_SMTP_PASSWORD=
TOLKOVO_SMTP_FROM=Tolkovo <noreply@example.com>

# --- Telegram personal accounts (optional) -------------------------------------
# From https://my.telegram.org → API development tools. Empty: bots only.
TOLKOVO_TELEGRAM_API_ID=
TOLKOVO_TELEGRAM_API_HASH=

# --- Antivirus for files of app reports and widget visitors (optional) --------
# host:port of clamd, e.g. clamav:3310 with a clamav service added to compose.
TOLKOVO_CLAMAV_ADDR=
