{
  "name": "@tolkovo/api-client",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "REST client generated from api/openapi.yaml: types, fetch client with CSRF, TanStack Query hooks.",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx"
  },
  "scripts": {
    "gen": "openapi-typescript ../../api/openapi.yaml --output src/schema.gen.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.104.1",
    "@tolkovo/config": "workspace:*",
    "@types/react": "19.3.0",
    "eslint": "10.12.0",
    "openapi-typescript": "7.13.0",
    "react": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
