    "test": "vitest run"
  },
  "devDependencies": {
    "@tolkovo/config": "workspace:*",
    "eslint": "10.12.0",
    "intl-messageformat": "11.2.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
