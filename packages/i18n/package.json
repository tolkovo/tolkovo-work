{
  "name": "@tolkovo/i18n",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "UI dictionaries (ru, en) shared by the panel; keys must match in both languages.",
